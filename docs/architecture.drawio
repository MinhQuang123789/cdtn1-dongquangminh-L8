        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 11\nskinparam packageStyle rectangle\ntop to bottom direction\n\nrectangle \&quot;LỚP NGUỒN DỮ LIỆU (Data Sources)\&quot; as L_SOURCE {\n  database \&quot;survey_responses.csv\\n(Phản hồi khảo sát)\&quot; as src_survey\n  database \&quot;tickets_history.csv\\n(Phiếu bảo hành)\&quot; as src_ticket\n  database \&quot;stores.csv\\n(Danh mục chi nhánh)\&quot; as src_store\n}\n\nrectangle \&quot;LỚP DỮ LIỆU TẠM (Staging Layer)\&quot; as L_STAGING {\n  collections \&quot;stg_survey_responses\&quot; as stg_survey\n  collections \&quot;stg_tickets_history\&quot; as stg_ticket\n  collections \&quot;stg_stores\&quot; as stg_store\n  database \&quot;reject_surveys\\n(Bảng cách ly dữ liệu lỗi)\&quot; as reject_tbl\n}\n\nrectangle \&quot;LỚP KHO DỮ LIỆU (Data Warehouse - Star Schema)\&quot; as L_DWH {\n  entity \&quot;fact_survey\\n(Grain: 1 dòng = 1 khảo sát)\&quot; as fact_tbl\n  entity \&quot;dim_date\&quot; as d_date\n  entity \&quot;dim_store (SCD Loại 2)\&quot; as d_store\n  entity \&quot;dim_customer\&quot; as d_cust\n  entity \&quot;dim_technician\&quot; as d_tech\n}\n\nrectangle \&quot;LỚP TRỰC QUAN HÓA (BI / Dashboard)\&quot; as L_BI {\n  node \&quot;Khung 1: Tổng quan CSAT/NPS Toàn chuỗi\&quot; as dash_1\n  node \&quot;Khung 2: Chi tiết Chi nhánh &amp; Kỹ thuật viên\&quot; as dash_2\n  node \&quot;Khung 3: Giám sát Phản hồi Tiêu cực\&quot; as dash_3\n}\n\nL_SOURCE --&gt; L_STAGING : \&quot;Trích xuất theo đợt (Batch Ingestion - Python)\&quot;\nstg_survey --&gt; reject_tbl : \&quot;Bản ghi vi phạm CL1-CL4\&quot;\nL_STAGING --&gt; L_DWH : \&quot;Làm sạch, biến đổi &amp; nạp (ETL/ELT)\&quot;\n\nd_date --&gt; fact_tbl\nd_store --&gt; fact_tbl\nd_cust --&gt; fact_tbl\nd_tech --&gt; fact_tbl\n\nL_DWH --&gt; L_BI : \&quot;Truy vấn SQL View / Analytical Queries\&quot;\n\nnote bottom of L_BI\n  &lt;b&gt;CHÚ THÍCH:&lt;/b&gt; Mũi tên thể hiện hướng đi một chiều của dữ liệu.\n  &lt;b&gt;NGOÀI PHẠM VI (WON&#39;T):&lt;/b&gt; Xử lý Real-time Streaming (Kafka), Data Lake phi cấu trúc.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lZHYhG_9dsWlp8Tz7KnK-1">
