        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 11\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 50\n\nentity \&quot;dim_date\&quot; as d_date {\n  PK date_key (INT) : (YYYYMMDD)\n  --\n  full_date (DATE)\n  year, quarter, month\n  week_of_year\n  is_weekend\n}\n\nentity \&quot;dim_store\&quot; as d_store {\n  PK store_key (INT)\n  --\n  store_id (NK)\n  store_name\n  manager_name (SCD 2)\n  city\n  valid_from, valid_to\n  is_current\n}\n\nentity \&quot;dim_customer\&quot; as d_cust {\n  PK customer_key (INT)\n  --\n  customer_id (NK)\n  full_name\n  phone_masked (QT-15)\n  customer_segment\n}\n\nentity \&quot;fact_survey\&quot; as fact {\n  PK survey_fact_key : (BIGINT)\n  --\n  FK date_key\n  FK store_key\n  FK customer_key\n  FK technician_key\n  ticket_code (Deg.) : (Khóa nghiệp vụ)\n  --\n  csat_score (1 - 5) : [Measures]\n  nps_score (0 - 10)\n  is_promoter (0/1)\n  is_detractor (0/1)\n  is_passive (0/1)\n  turnaround_hours\n}\n\nentity \&quot;dim_technician\&quot; as d_tech {\n  PK technician_key (INT)\n  --\n  technician_id (NK)\n  full_name\n  skill_level\n}\n\nd_store -[hidden]right- d_cust\nd_date -[hidden]down- fact\nfact -[hidden]down- d_tech\n\nd_date --&gt; fact : \&quot;1 : N\&quot;\nd_store --&gt; fact : \&quot;1 : N\&quot;\nd_cust --&gt; fact : \&quot;1 : N\&quot;\nd_tech --&gt; fact : \&quot;1 : N\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FArx_EUQCDQjfzTJT0vA-1">
